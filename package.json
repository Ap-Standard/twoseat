{
  "name": "twoseat",
  "version": "0.1.0",
  "description": "A measured AI code-review gate for GitHub pull requests, published with its own labeled benchmark.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:text": "node scripts/check-no-binary-source.mjs",
    "bench:build": "node bench/build.mjs",
    "bench": "npm run bench:build && node bench/dist/bench.mjs",
    "bench:rescore": "npm run bench:build && node bench/dist/rescore.mjs",
    "scorecard": "npm run bench:build && node bench/dist/scorecard.mjs",
    "scorecard:check": "npm run bench:build && node bench/dist/scorecard.mjs --check",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ap-Standard/twoseat.git"
  },
  "bugs": {
    "url": "https://github.com/Ap-Standard/twoseat/issues"
  },
  "homepage": "https://github.com/Ap-Standard/twoseat#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
